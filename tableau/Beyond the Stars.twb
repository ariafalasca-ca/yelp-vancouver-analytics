            </column>
            <column caption="City Standardized" datatype="string" name="[Calculation_1099847620775939]" role="dimension" type="nominal">
              <calculation class="tableau" formula="CASE [Calculation_1099847620194306]&#10;WHEN &quot;VANCOVER&quot; THEN &quot;VANCOUVER&quot;&#10;WHEN &quot;VANCOUVER BC&quot; THEN &quot;VANCOUVER&quot;&#10;WHEN &quot;VANCOUVER DT (BC)&quot; THEN &quot;VANCOUVER&quot;&#10;WHEN &quot;DOWNTOWN VANCOUVER&quot; THEN &quot;VANCOUVER&quot;&#10;WHEN &quot;EAST VANCOUVER&quot; THEN &quot;VANCOUVER&quot;&#10;WHEN &quot;KITSILANO&quot; THEN &quot;VANCOUVER&quot;&#10;WHEN &quot;WEST POINT GREY&quot; THEN &quot;VANCOUVER&quot;&#10;&#10;WHEN &quot;NEW WEST MINSTER&quot; THEN &quot;NEW WESTMINSTER&quot;&#10;WHEN &quot;NEWWESTMINSTER&quot; THEN &quot;NEW WESTMINSTER&quot;&#10;WHEN &quot;NEW WESTMINISTER&quot; THEN &quot;NEW WESTMINSTER&quot;&#10;&#10;WHEN &quot;N VANCOUVER&quot; THEN &quot;NORTH VANCOUVER&quot;&#10;WHEN &quot;NORTH VANCOUVER DISTRICT&quot; THEN &quot;NORTH VANCOUVER&quot;&#10;&#10;WHEN &quot;STEVESTON&quot; THEN &quot;RICHMOND&quot;&#10;WHEN &quot;LADNER&quot; THEN &quot;DELTA&quot;&#10;WHEN &quot;NORTH DELTA&quot; THEN &quot;DELTA&quot;&#10;WHEN &quot;CLOVERDALE&quot; THEN &quot;SURREY&quot;&#10;WHEN &quot;FRASER HEIGHTS&quot; THEN &quot;SURREY&quot;&#10;WHEN &quot;LOUGHEED&quot; THEN &quot;BURNABY&quot;&#10;&#10;ELSE [Calculation_1099847620194306]&#10;END" />
            </column>
            <column caption="Is Metro Vancouver" datatype="boolean" name="[Calculation_1099847620874244]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Calculation_1099847620775939] IN (&#10;&quot;VANCOUVER&quot;,&#10;&quot;RICHMOND&quot;,&#10;&quot;BURNABY&quot;,&#10;&quot;SURREY&quot;,&#10;&quot;COQUITLAM&quot;,&#10;&quot;NORTH VANCOUVER&quot;,&#10;&quot;WEST VANCOUVER&quot;,&#10;&quot;NEW WESTMINSTER&quot;,&#10;&quot;DELTA&quot;,&#10;&quot;PORT COQUITLAM&quot;,&#10;&quot;PORT MOODY&quot;,&#10;&quot;LANGLEY&quot;,&#10;&quot;MAPLE RIDGE&quot;,&#10;&quot;PITT MEADOWS&quot;,&#10;&quot;WHITE ROCK&quot;,&#10;&quot;ANMORE&quot;,&#10;&quot;BELCARRA&quot;,&#10;&quot;BOWEN ISLAND&quot;,&#10;&quot;LIONS BAY&quot;,&#10;&quot;TSAWWASSEN&quot;,&#10;&quot;GREATER VANCOUVER&quot;,&#10;&quot;GREATER VANCOUVER A&quot;,&#10;&quot;GREATER VANCOUVER AREA&quot;,&#10;&quot;GREATER VANCOUVER REGIONAL DISTRICT&quot;&#10;)" />
