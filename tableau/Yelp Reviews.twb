            <run>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone h='34167' id='69' type-v2='text' w='27891' x='67656' y='38056'>
          <formatted-text>
            <run bold='true' fontcolor='#123438' fontname='Arial' fontsize='12'>Review volume fell; average ratings changed less.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#123438' fontname='Arial' fontsize='12'>Monthly Yelp </run>
            <run bold='true' fontcolor='#123438' fontname='Arial' fontsize='12'>reviews dropped </run>
            <run fontcolor='#123438' fontname='Arial' fontsize='12'>sharply in March–April 2020, followed by a </run>
            <run bold='true' fontcolor='#123438' fontname='Arial' fontsize='12'>partial recovery</run>
            <run fontcolor='#123438' fontname='Arial' fontsize='12'>.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#123438' fontname='Arial' fontsize='12'>Average </run>
            <run bold='true' fontcolor='#123438' fontname='Arial' fontsize='12'>ratings remained </run>
            <run fontcolor='#123438' fontname='Arial' fontsize='12'>relatively </run>
            <run bold='true' fontcolor='#123438' fontname='Arial' fontsize='12'>stable</run>
            <run fontcolor='#123438' fontname='Arial' fontsize='12'>, suggesting a much stronger </run>
            <run bold='true' fontcolor='#123438' fontname='Arial' fontsize='12'>change in review volume </run>
            <run fontcolor='#123438' fontname='Arial' fontsize='12'>than on the scores submitted by users.</run>
          </formatted-text>
        </zone>
      </zones>
