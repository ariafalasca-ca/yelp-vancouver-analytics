        </zone>
        <zone flipboard-zone-id='5' h='33056' id='8' story-point-id='4' type-v2='text' w='29844' x='67188' y='49306'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#123438'>Between 2008 and 2020, </run>
            <run bold='true' fontalignment='0' fontcolor='#123438'>five-star reviews increased </run>
            <run fontalignment='0' fontcolor='#123438'>from 26.7% to 42.4%, while </run>
            <run bold='true' fontalignment='0' fontcolor='#123438'>one-star reviews rose </run>
            <run fontalignment='0' fontcolor='#123438'>from 2.0% to 16.3%. </run>
            <run bold='true' fontalignment='0' fontcolor='#123438'>Ratings </run>
            <run fontalignment='0' fontcolor='#123438'>became </run>
            <run bold='true' fontalignment='0' fontcolor='#123438'>more concentrated at the extremes</run>
            <run fontalignment='0' fontcolor='#123438'>, with fewer reviews in the middle categories. This describes a change in submitted ratings; it </run>
            <run bold='true' fontalignment='0' fontcolor='#123438'>does not </run>
            <run fontalignment='0' fontcolor='#123438'>establish a </run>
            <run bold='true' fontalignment='0' fontcolor='#123438'>change </run>
            <run fontalignment='0' fontcolor='#123438'>in </run>
            <run bold='true' fontalignment='0' fontcolor='#123438'>business quality</run>
            <run fontalignment='0' fontcolor='#123438'>.</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{155463CA-0324-4117-91B1-6D2540F0EC2D}' />
    </dashboard>
