        <zone h='35684' id='44' name='COVID - Monthly Review Volume' show-title='false' w='60200' x='1933' y='26105' />
        <zone h='31158' id='45' name='COVID - Average Rating' show-title='false' w='58067' x='3400' y='66632' />
        <zone forceUpdate='true' h='6737' id='52' type-v2='text' w='28067' x='2000' y='59579'>
          <formatted-text>
