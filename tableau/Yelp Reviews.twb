      <size maxheight='720' maxwidth='1280' minheight='720' minwidth='1280' preset-index='0' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97778' id='1' param='vert' removable='false' type-v2='layout-flow' w='98750' x='625' y='1111'>
            <zone h='5972' id='3' type-v2='title' w='98750' x='625' y='1111' />
            <zone fixed-size='122' h='16944' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98750' x='625' y='7083' />
            <zone h='74862' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98750' x='625' y='24027'>
              <flipboard active-id='4' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='01 | More Extreme Ratings: The Shift Toward One and Five Stars' captured-sheet='Review Stars by Year' id='4' />
                  <story-point caption='02 | COVID-19: Fewer Reviews, Similar Ratings' captured-sheet='COVID-19 Review Patterns' id='2' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#444444' />
            <format attr='border-style' value='none' />
