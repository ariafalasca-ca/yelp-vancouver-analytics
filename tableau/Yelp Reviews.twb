    <dashboard name='Beyond the Stars - Review Dynamics' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Georgia' fontsize='28'>&lt;Sheet Name&gt;</run>
